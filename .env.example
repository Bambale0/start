# Development-only example. Never place production secrets in this file.

START_ENVIRONMENT=development
START_LOG_LEVEL=INFO
START_DATABASE_URL=postgresql+asyncpg://start:start_dev_only@postgres:5432/start
START_REDIS_URL=redis://redis:6379/0

POSTGRES_DB=start
POSTGRES_USER=start
POSTGRES_PASSWORD=start_dev_only
